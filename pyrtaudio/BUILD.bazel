
load("@pybind11_bazel//:build_defs.bzl", "pybind_extension")
load("@rules_python//python:defs.bzl", "py_test")

pybind_extension(
    name = "pyrtaudio",
    srcs = ["main.cxx"],
    deps = ["//:rtaudio"],
)

py_test(
    name = "pyrtaudio_test",
    srcs = ["test_pyrtaudio.py"],
    deps = [":pyrtaudio"],
    legacy_create_init = 0,
    main = "test_pyrtaudio.py",
)